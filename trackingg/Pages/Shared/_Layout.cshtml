@using Microsoft.Extensions.Localization
@inject IStringLocalizer<trackingg.SharedResource> Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - trackingg</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/trackingg.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">trackingg</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">@Localizer["Home"]</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Issues/New">@Localizer["New Issue"]</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="projectsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["Projects"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="projectsDropdown">
                                    <li><a class="dropdown-item" asp-page="/Projects/Index">@Localizer["View All"]</a></li>
                                    <li><a class="dropdown-item" asp-page="/Projects/New">@Localizer["Create New"]</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["Admin"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-page="/Admin/Users">@Localizer["Users"]</a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <!-- 🌍 Language Switcher -->
                <form method="post" asp-page="/SetLanguage" class="d-flex align-items-center me-2">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <select name="culture" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
                        <option value="en" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "en" ? "selected" : null)">
                            @Localizer["English"]
                        </option>
                        <option value="lt" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "lt" ? "selected" : null)">
                            @Localizer["Lithuanian"]
                        </option>
                    </select>
                </form>





                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2022 - trackingg
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
