@page
@using Humanizer
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Localization
@using trackingg.Extensions
@model IndexModel
@inject IStringLocalizer<trackingg.SharedResource> Localizer

@{
    ViewData["Title"] = "Home page";
}

<h1>@Localizer["Welcome"]</h1>
<p>@Localizer["Home page subtitle"]</p>

<div class="mt-5">
    <a asp-page="/Issues/New" class="w-20 btn btn-primary m-2">+ @Localizer["Add new"]</a>

    @if (!Model.Issues.Any())
    {
        <p class="text-center">@Localizer["No data to display"]</p>
    }
    else
    {
        <div class="row g-0">
            @foreach (var issue in Model.Issues)
            {
                <div class="card col-3 m-2">
                    <div class="card-header d-flex justify-content-between">
                        <span>@issue.IssueType</span>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@issue.Id"
                              onsubmit="return confirm('@Localizer["Delete confirm"]');">
                            <button type="submit" class="btn btn-sm btn-danger">@Localizer["Delete"]</button>
                        </form>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-truncate">
                            <a asp-page="/Issues/Detail" asp-route-id="@issue.Id" class="link-dark text-decoration-none">
                                @issue.Title
                            </a>
                        </h5>
                        <span class="@issue.Priority.ToCssClass()">@issue.Priority</span>
                    </div>
                    <div class="card-footer text-muted d-flex justify-content-between">
                        <small>@issue.Created.Humanize(utcDate:false)</small>
                        <div>
                            <a asp-page="/Issues/Edit" asp-route-id="@issue.Id" class="btn btn-sm btn-primary">@Localizer["Edit"]</a>
                            <a asp-page="/Issues/Detail" asp-route-id="@issue.Id" class="btn btn-sm btn-info ms-1">@Localizer["Details"]</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
