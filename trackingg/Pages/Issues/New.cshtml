@page
@model trackingg.Pages.Issues.NewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<trackingg.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["New Issue"];
}

<h1>@Localizer["New Issue"]</h1>

<form method="post" id="new-issue-form">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Issue.Title">@Localizer["Title"]</label>
        <input asp-for="Issue.Title" class="form-control" />
        <span asp-validation-for="Issue.Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Issue.Description">@Localizer["Description"]</label>
        <textarea asp-for="Issue.Description" class="form-control"></textarea>
        <span asp-validation-for="Issue.Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Issue.ProjectId">@Localizer["Project"]</label>
        <select asp-for="Issue.ProjectId" class="form-control">
            <option value="">@Localizer["Select Project"]</option>
            @foreach (var project in Model.Projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
        <span asp-validation-for="Issue.ProjectId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Issue.Priority">@Localizer["Priority"]</label>
        <select asp-for="Issue.Priority" class="form-control">
            @foreach (var priority in Enum.GetValues(typeof(trackingg.Models.Priority)))
            {
                <option value="@priority">@priority</option>
            }
        </select>
        <span asp-validation-for="Issue.Priority" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Issue.IssueType">@Localizer["Type"]</label>
        <select asp-for="Issue.IssueType" class="form-control">
            @foreach (var type in Enum.GetValues(typeof(trackingg.Models.IssueType)))
            {
                <option value="@type">@type</option>
            }
        </select>
        <span asp-validation-for="Issue.IssueType" class="text-danger"></span>
    </div>
    

    <button type="submit" class="btn btn-success">@Localizer["Submit"]</button>
    <a asp-page="/Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
</form>
