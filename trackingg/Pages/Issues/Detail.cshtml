@page "{id:int}"
@model DetailModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Localization
@using trackingg.Extensions
@inject IStringLocalizer<trackingg.SharedResource> Localizer

<h1>@Localizer["Issue Details"]</h1>

<div class="card">
    <div class="card-header">
        <h4>@Model.Issue.Title</h4>
    </div>
    <div class="card-body">
        <p><strong>@Localizer["Description"]:</strong> @Model.Issue.Description</p>
        <p><strong>@Localizer["Type"]:</strong> @Model.Issue.IssueType</p>
        <p><strong>@Localizer["Priority"]:</strong> <span class="@Model.Issue.Priority.ToCssClass()">@Model.Issue.Priority</span></p>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <small>@Localizer["Created"] @Model.Issue.Created.ToString("yyyy-MM-dd HH:mm")</small>
        <div>
            <a asp-page="/Issues/Edit" asp-route-id="@Model.Issue.Id" class="btn btn-sm btn-primary">@Localizer["Edit"]</a>
        </div>
    </div>
</div>