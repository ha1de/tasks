@page
@model UsersModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<trackingg.SharedResource> Localizer

<h1>@Localizer["User Management"]</h1>

<table class="table">
    <thead>
    <tr>
        <th>@Localizer["Email"]</th>
        <th>@Localizer["Roles"]</th>
        <th>@Localizer["Actions"]</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Email</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td>
                <a asp-page="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-primary">@Localizer["Edit"]</a>
            </td>
        </tr>
    }
    </tbody>
</table>
