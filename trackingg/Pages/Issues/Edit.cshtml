@page "{id}"
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using trackingg.Models
@model trackingg.Pages.Issues.EditModel
@{
    ViewData["Title"] = "Edit Issue";
}

<div class="mt-5">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Issue.Id" />

        <div class="form-group mb-3">
            <label asp-for="Issue.Title" class="form-label"></label>
            <input asp-for="Issue.Title" class="form-control" />
            <span asp-validation-for="Issue.Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Issue.Description" class="form-label"></label>
            <textarea asp-for="Issue.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Issue.Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Issue.IssueType" class="form-label">Type</label>
            <select class="form-select" asp-for="Issue.IssueType" asp-items="Html.GetEnumSelectList<IssueType>()">
                <option value="">-- Select Type --</option>
            </select>
            <span asp-validation-for="Issue.IssueType" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Issue.Priority" class="form-label">Priority</label>
            <select class="form-select" asp-for="Issue.Priority" asp-items="Html.GetEnumSelectList<Priority>()">
                <option value="">-- Select Priority --</option>
            </select>
            <span asp-validation-for="Issue.Priority" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Issue.ProjectId" class="form-label">Project</label>
            <select class="form-select" asp-for="Issue.ProjectId"
                    asp-items="@(new SelectList(Model.Projects, "Id", "Name"))">
                <option value="">-- Select Project --</option>
            </select>
            <span asp-validation-for="Issue.ProjectId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Issue.AssignedToId" class="form-label">Assign To</label>
            <select class="form-select" asp-for="Issue.AssignedToId"
                    asp-items="@(new SelectList(Model.Users, "Id", "UserName"))">
                <option value="">-- Select User --</option>
            </select>
            <span asp-validation-for="Issue.AssignedToId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="./Detail" asp-route-id="@Model.Issue.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}