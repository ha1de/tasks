@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using trackingg.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.Extensions.Localization
@using trackingg.Data
@inject IStringLocalizer<trackingg.SharedResource> Localizer

@if (SignInManager.IsSignedIn(User))
{
    <form class="form-inline" asp-page="/Account/Logout" method="post" asp-route-returnUrl="/">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-page="/Account/Manage/Index">@UserManager.GetUserName(User)</a>
            </li>
            <li class="nav-item">
                <button type="submit" class="nav-link btn btn-link text-dark">@Localizer["Logout"]</button>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Login">@Localizer["Login"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Register">@Localizer["Register"]</a>
        </li>
    </ul>
}
